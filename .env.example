# Bachelor:Re — environment
# คัดลอกเป็น .env แล้วแก้ตามเครื่อง (ทุกตัวมีค่า default อยู่ใน core/paths.js — ไม่ตั้งก็ใช้ได้)

# เก็บ component / downloads / state ไว้ที่ไหน
BR_RE_ROOT=.
BR_DOWNLOAD_DIR=downloads
BR_COMPONENT_DIR=components
BR_DATA_FILE=data/state.json

# พอร์ต UI พรีวิว (dev server; tauri devUrl = 5178)
BR_UI_PORT=5178

# แหล่ง OpenBachelor บน GitHub
BR_GITHUB_OWNER=pfyy
BR_COMPONENTS=OpenBachelorS,OpenBachelorC

# Python ตัวที่ใช้รัน OpenBachelor (S/C ต้องมี Python 3.10+)
BR_PYTHON=python

# เกม PC (ตั้งเมื่อเจอ GamePath ผ่าน UI/Settings — M3 ใช้จริง)
BR_GAME_PATH=
BR_GAME_EXE_FILE=ak_exe_filepath.txt

# Region/เวอร์ชัน client (รองรับ PC EN 37.7.41)
BR_REGION=EN
BR_CLIENT_VERSION=37.7.41
